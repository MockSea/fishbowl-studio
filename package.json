{
  "name": "fishbowl-studio",
  "version": "0.1.0",
  "description": "A social-post drafting studio that runs on your computer and opens in your browser.",
  "private": true,
  "type": "module",
  "imports": {
    "#core/*": "./core/lib/*"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/fishbowl-studio.js",
    "test": "node --test",
    "seed": "node dev/seed.mjs",
    "shots": "node dev/shots.mjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "prepare": "node scripts/prepare.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "mammoth": "^1.13.0",
    "unpdf": "^2.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "bin": {
    "fishbowl-studio": "bin/fishbowl-studio.js"
  },
  "files": [
    "bin",
    "server",
    "core/lib",
    "core/platforms",
    "core/shapes",
    "core/accounts",
    "core/defaults",
    "core/package.json",
    "core/README.md",
    "README.md",
    "LICENSE"
  ],
  "bundleDependencies": [
    "@anthropic-ai/sdk",
    "mammoth",
    "unpdf"
  ]
}
